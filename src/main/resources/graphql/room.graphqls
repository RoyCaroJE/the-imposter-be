type ResultWithCountForRoomDTO {
    queryCount: Int!
    result: [RoomDTO!]!
}

type RoomDTO {
    publicId: ID!
    code: String!
    adminPublicId: ID!
    numImpostors: Int!
    language: String!
    joinedPlayerPublicId: ID!
    players: [PlayerDTO!]!
}

type RoomStatusDTO {
    status: GameStatus!
    startingPlayer: String
    language: String!
    numImposters: Int!
    players: [PlayerDTO!]!
}

enum GameStatus {
    WAITING
    STARTED
    PLAYING
}