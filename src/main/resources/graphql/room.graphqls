type ResultWithCountForRoomDTO {
    queryCount: Int!
    result: [RoomDTO!]!
}

type RoomDTO {
    publicId: ID!
    code: String!
    adminPublicId: ID!
    numImpostors: Int!
    language: Language!
    joinedPlayerPublicId: ID!
    gameStatus: GameStatus!
    difficulty: Difficulty!
    privateRoom: Boolean!
    players: [PlayerDTO!]!
}

type RoomStatusDTO {
    status: GameStatus!
    startingPlayer: String
    language: Language!
    numImposters: Int!
    lastImposters: [String!]
    lastWord: String
    difficulty: Difficulty!
    privateRoom: Boolean!
    players: [PlayerDTO!]!
}

enum GameStatus {
    WAITING
    STARTED
    PLAYING
}

enum Language {
    ES
    EN
}

enum Difficulty {
    EASY
    MEDIUM
    HARD
    MIXED
}

type ResultWithCountForPublicRoomsDTO {
    queryCount: Int!
    result: [PublicRoomsDTO!]!
}

type PublicRoomsDTO {
    publicId: ID!
    code: String!
    adminName: String!
    numImpostors: Int!
    language: Language!
    difficulty: Difficulty!
}