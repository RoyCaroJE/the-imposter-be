type Mutation {
    # Room
    createRoom(numImpostors: Int!, playerName: String!): ResultWithCountForRoomDTO!

    # Player
    joinRoom(roomCode: String!, playerName: String!): ResultWithCountForRoomDTO!

    # Heartbeat
    playerHeartbeat(playerPublicId: ID!): Boolean!
}

type Query {
    getRoomByCode(roomCode: String!): ResultWithCountForRoomDTO!
}

type Subscription {
    playersUpdated(roomPublicId: ID!): [PlayerDTO!]!
}