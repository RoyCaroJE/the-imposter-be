type Mutation {
    # Room
    startGame(roomPublicId: UUID!adminPublicId: UUID!): Boolean!
    endGame(roomPublicId: UUID!adminPublicId: UUID!): Boolean!
    restartGame(roomPublicId: UUID!adminPublicId: UUID!): Boolean!

    # Player
    joinRoom(roomCode: String!playerName: String!): UUID!
    leaveRoom(playerPublicId: UUID!): Boolean!
    disconnectPlayer(playerPublicId: UUID!): Boolean!
    reconnectPlayer(playerPublicId: UUID!): Boolean!
}

type Query {
    getRoomByCode(roomCode: String!): RoomDTO
    getRoomByPublicId(roomPublicId: UUID!): RoomDTO
    getPlayersByRoom(roomPublicId: UUID!): [Player!]!
}

type Subscription {
    gameStarted(roomPublicId: UUID!playerPublicId: UUID!): GameStartPayload!
    gameEnded(roomPublicId: UUID!): GameEndPayload!
    playersUpdated(roomPublicId: UUID!): [Player!]!
    gameRestarted(roomPublicId: UUID!): Boolean!
}


scalar UUID
scalar Instant