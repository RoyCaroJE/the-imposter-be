type Mutation {
    # Room
    createRoom(numImpostors: Int!, playerName: String!, language: String!): ResultWithCountForRoomDTO!
    editRoom(roomPublicId: ID!, numImposters: Int!, language: String!): Boolean!
    startGame(roomPublicId: ID!): Boolean!
    startDiscussion(roomPublicId: ID!): Boolean!
    finishDiscussion(roomPublicId: ID!): Boolean!

    # Player
    joinRoom(roomCode: String!, playerName: String!): ResultWithCountForRoomDTO!
    playerReady(playerPublicId: ID!): Boolean!
    leaveRoom(playerPublicId: ID!): Boolean!
    kickPlayer(playerPublicId: ID!): Boolean!

    # Heartbeat
    playerHeartbeat(playerPublicId: ID!): Boolean!
}

type Query {
    getRoomByCode(roomCode: String!): ResultWithCountForRoomDTO!
    getPlayerWord(playerPublicId: ID!): ResultWithCountForPlayerWordDTO!
}

type Subscription {
    roomStatus(roomPublicId: ID!): RoomStatusDTO!
}